# ── 공통 ─────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Seoul

# ── API (Nest) ──────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── DB (MariaDB) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=beauty
DB_PASSWORD=change-me
DB_NAME=beauty_crm
DB_ROOT_PASSWORD=change-me-root
DB_LOGGING=false

# ── 인증 ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d

# ── 개인정보 암호화 (32바이트 hex: openssl rand -hex 32) ──
PHONE_ENC_KEY=
PHONE_HMAC_KEY=

# ── 파일 저장소 (S3 호환: 로컬·MVP는 SeaweedFS, 이전 후 NCP Object Storage 등) ──
SEAWEEDFS_VERSION=4.55
STORAGE_PORT=8333
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=beauty-crm
STORAGE_ACCESS_KEY=beauty
STORAGE_SECRET_KEY=change-me-storage
STORAGE_FORCE_PATH_STYLE=true

# ── STT (네이버 CLOVA Speech) ────────────────────────
STT_PROVIDER=CLOVA
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=

# ── LLM (HyperCLOVA X / CLOVA Studio) ───────────────
LLM_PROVIDER=HYPERCLOVA
LLM_MODEL=HCX-007
CLOVA_STUDIO_API_KEY=

# ── Web (Next) ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
