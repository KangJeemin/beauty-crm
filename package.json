{
  "name": "beauty-crm",
  "private": true,
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d mariadb seaweedfs",
    "db:migrate": "npm run migration:run -w @beauty-crm/api",
    "db:revert": "npm run migration:revert -w @beauty-crm/api",
    "db:status": "npm run migration:show -w @beauty-crm/api"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
